# ApplicantOS — environment template.
#
#   cp .env.example .env
#
# This file is the operator-facing index of every knob in `app/config/settings.py`.
# docs/CONTRACTS.md §1 is binding: the env-var name is the UPPER_SNAKE form of the Settings
# field name, and this file must list every key. All 87 are here, in declaration order.
#
# Every line below is commented out and shows the code default — EXCEPT the two safety
# switches in the POLICY / SAFETY section, which are shipped live and explicit so that
# copying this file to `.env` produces the safe posture rather than an implicit one.
# Uncomment only what you actually want to override; a commented key falls through to the
# default in settings.py, which is not the same as setting it to an empty value.
#
# Keys whose default is `None` are left with no value on purpose. Do NOT uncomment them and
# leave them blank: an empty string is a *value*, and it defeats the derivations below
# (SYNC_DATABASE_URL, CELERY_BROKER_URL and CELERY_RESULT_BACKEND are computed only while
# they are unset).
#
# Secrets — SECRET_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, GITHUB_TOKEN, AWS_*, SENTRY_DSN —
# are intentionally valueless here. `.env` is gitignored; `.env.example` is not. Never put a
# real credential in this file.
#
# ── Quick start ────────────────────────────────────────────────────────────────────────
# Zero-infrastructure install (no PostgreSQL, no Redis): set SQLITE_MODE=true and install
# with `pip install -e ".[sqlite]"`. That single switch rewrites DATABASE_URL to a local
# aiosqlite file under DATA_DIR, moves the vector store to sqlite_vec and the cache to disk.


# ── Application ────────────────────────────────────────────────────────────────────────

# APP_NAME=ApplicantOS
# ENVIRONMENT=local                      # local | dev | prod
# DEBUG=false
# SECRET_KEY=                            # SECRET — default is "change-me"; override in prod
# DATA_DIR=./var                         # root for all local state


# ── Persistence ────────────────────────────────────────────────────────────────────────

# DATABASE_URL=postgresql+asyncpg://applicantos:applicantos@localhost:5432/applicantos
# SYNC_DATABASE_URL=                     # derived from DATABASE_URL when unset (Alembic)
# SQLITE_MODE=false                      # true => the zero-infrastructure install
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=                     # defaults to REDIS_URL when unset
# CELERY_RESULT_BACKEND=                 # defaults to REDIS_URL when unset


# ── Cache ──────────────────────────────────────────────────────────────────────────────

# CACHE_BACKEND=redis                    # memory | disk | redis (SQLITE_MODE forces disk)
# CACHE_DIR=./var/cache
# CACHE_DEFAULT_TTL=86400
# CACHE_LLM_RESPONSES=true
# CACHE_EMBEDDINGS=true


# ── AI ─────────────────────────────────────────────────────────────────────────────────
# The whole pipeline runs end-to-end with zero API keys: LLM_PROVIDER=null selects the
# deterministic offline stub.

# LLM_PROVIDER=anthropic                 # anthropic | openai | local | null
# ANTHROPIC_API_KEY=                     # SECRET
# OPENAI_API_KEY=                        # SECRET
# LLM_MODEL_REASONING=claude-sonnet-4-5
# LLM_MODEL_FAST=claude-haiku-4-5-20251001
# LLM_MODEL_LOCAL=llama3.1:8b
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_SECONDS=90
# LLM_DAILY_TOKEN_BUDGET=2000000


# ── Embeddings / vector store ──────────────────────────────────────────────────────────

# EMBEDDING_PROVIDER=openai              # openai | local | hashing (hashing is offline)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# VECTOR_STORE=pgvector                  # pgvector | sqlite_vec | memory
# KNOWLEDGE_CHUNK_TOKENS=512
# KNOWLEDGE_CHUNK_OVERLAP=64


# ── Knowledge engine ───────────────────────────────────────────────────────────────────

# KNOWLEDGE_AUTOINDEX=true
# KNOWLEDGE_REINDEX_INTERVAL_MINUTES=60
# GITHUB_TOKEN=                          # SECRET — unauthenticated works at lower rate limits
# GITHUB_INCLUDE_FORKS=false
# GITHUB_MAX_REPOS=200
# WEBSITE_CRAWL_MAX_PAGES=40
# WEBSITE_CRAWL_MAX_DEPTH=3
# PROJECT_SCAN_MAX_FILES=2000
# PROJECT_SCAN_MAX_FILE_BYTES=256000


# ── Storage ────────────────────────────────────────────────────────────────────────────

# STORAGE_BACKEND=local                  # local | s3
# STORAGE_LOCAL_ROOT=./var/storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=                     # SECRET
# AWS_SECRET_ACCESS_KEY=                 # SECRET


# ── Browser ────────────────────────────────────────────────────────────────────────────

# PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_SLOW_MO_MS=0
# PLAYWRIGHT_TIMEOUT_MS=30000
# BROWSER_USER_DATA_DIR=./var/browser
# SCREENSHOT_DIR=./var/screenshots


# ── Policy / safety ────────────────────────────────────────────────────────────────────
#
# THE KILL SWITCH (docs/CONTRACTS.md §18.3). Submission requires AUTO_APPLY_ENABLED=true
# AND DRY_RUN=false. Both are shipped here at their safe position, uncommented, so the
# posture of any `.env` copied from this file is stated rather than assumed. With either
# line as it stands, `AutoFiller.submit` returns False WITHOUT clicking anything.

AUTO_APPLY_ENABLED=false
DRY_RUN=true

# AUTO_APPLY_MIN_SCORE=70
# MAX_APPLICATIONS_PER_DAY=50
# MAX_APPLICATIONS_PER_SESSION=200
# MAX_ESSAY_QUESTIONS_BEFORE_REVIEW=3    # more essays than this => NEEDS_REVIEW
# MIN_ANSWER_CONFIDENCE=0.75             # below this => NEEDS_REVIEW, never a guess
# DELETE_TEMP_RESUME_AFTER_SUBMIT=true


# ── Documents ──────────────────────────────────────────────────────────────────────────

# PDF_ENGINE=latex                       # latex | docx | html
# LATEX_BINARY=tectonic
# RESUME_MAX_PAGES=1
# RESUME_TEMPLATE=modern


# ── API / desktop ──────────────────────────────────────────────────────────────────────

# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=["http://localhost:5173","app://applicantos"]


# ── Observability ──────────────────────────────────────────────────────────────────────

# LOG_LEVEL=INFO
# LOG_JSON=true
# METRICS_ENABLED=true
# SENTRY_DSN=                            # SECRET


# ── Application status sync ────────────────────────────────────────────────────────────
#
# Rejections, interview invitations and offers arrive by email, so ApplicantOS reads the
# outcome from your mailbox instead of asking you to type it in. Nothing is read until you
# explicitly connect a mailbox in the desktop app — with no connected account every key
# below is inert. Access is READ-ONLY by construction (docs/CONTRACTS.md §17.8): the OAuth
# scopes requested are `gmail.readonly` and `Mail.Read`, IMAP mailboxes are opened with
# readonly=true, and no send/delete/move/flag call exists anywhere in `app/tracking/`.
#
# Queries are never a full mailbox sweep: every search is bounded by
# STATUS_SYNC_LOOKBACK_DAYS *and* by a sender allowlist built from the companies you
# actually applied to plus the known ATS relay domains.

# STATUS_SYNC_ENABLED=true
# STATUS_SYNC_ON_LAUNCH=true             # sync once when the desktop app starts
# STATUS_SYNC_INTERVAL_MINUTES=30        # background poll cadence (celery beat)
# STATUS_SYNC_LOOKBACK_DAYS=120          # hard ceiling on how far back any search reaches
# STATUS_SYNC_MIN_CONFIDENCE=0.80        # below this => stored for review, never applied
# STATUS_SYNC_AUTO_APPLY=true            # apply high-confidence outcomes without asking
# STATUS_SYNC_MAX_MESSAGES_PER_RUN=500
# GHOSTED_AFTER_DAYS=45                  # silence for this long => inferred `ghosted`


# ── Mailbox providers ──────────────────────────────────────────────────────────────────
#
# OAuth *application* identity only. Your access token, refresh token and IMAP app
# password are NEVER stored here or in the database — they live in the OS keychain
# (Windows Credential Manager / macOS Keychain / Secret Service) and are addressed by the
# `credential_ref` on the email account row. Install `keyring` to use any mailbox.

# GMAIL_CLIENT_ID=                       # SECRET — OAuth client for gmail.readonly
# GMAIL_CLIENT_SECRET=                   # SECRET
# OUTLOOK_CLIENT_ID=                     # SECRET — OAuth client for Mail.Read
# OUTLOOK_CLIENT_SECRET=                 # SECRET
# IMAP_HOST=                             # e.g. imap.gmail.com, imap.fastmail.com
# IMAP_PORT=993
# IMAP_USE_SSL=true
